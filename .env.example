# Optional public/personal API keys (never commit private secrets)
# Free TMDB v3 API key unlocks multilingual (EN/RU/TR) movies, Russian cinema, and Turkish Dizis:
VITE_TMDB_API_KEY=

# Optional Kinopoisk Unofficial API key for CIS ratings & metadata enrichment:
VITE_KINOPOISK_API_KEY=

# Optional Discord Application ID for local desktop Rich Presence IPC:
VITE_DISCORD_APPLICATION_ID=

# Default UI language override (en | ru | tr). Leave blank for auto-detection:
VITE_DEFAULT_LOCALE=
